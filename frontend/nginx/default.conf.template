server {
    listen ${NGINX_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Asset immutabili di SvelteKit: hash nel nome file, cache aggressiva
    location /_app/immutable/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Proxy verso il backend (usato solo in standalone/docker-compose;
    # in Kubernetes il Gateway instrada /api prima di arrivare a nginx)
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback: ogni route client-side torna index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
